1317. Convert int to the sum of two non zero integers

class Solution {
    public int[] getNoZeroIntegers(int n) {
    for(int a=1;a<=n-1;a++){
        int b=n-a;
        if(check(a)&&check(b)){
            return new int[]{a,b};
        }
    }
    return new int[]{};  
    }
    
    private boolean check(int num){
        while(num>0){
            if(num%10==0){
                return false;
            }
            num=num/10;
        }
        return true;
    }
}
