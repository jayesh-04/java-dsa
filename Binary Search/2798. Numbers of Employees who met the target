2798. Numbers of Employees who met the target

class Solution {
    public int numberOfEmployeesWhoMetTarget(int[] hours, int target) {
        int count=0;
        for(int i=0;i<hours.length;i++){
            if(target<=hours[i]){
                count++;
            }else{
                continue;
            }
        }
        return count;
    }
}
