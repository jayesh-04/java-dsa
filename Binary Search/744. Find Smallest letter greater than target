744. Find Smallest letter greater than target
https://leetcode.com/problems/find-smallest-letter-greater-than-target/

class Solution {
    public char nextGreatestLetter(char[] letters, char target) {
        int start=0;
        int end=letters.length-1;                     
        while(start<=end){                            // run loop until start becomes greater than end 
            int mid=start+(end-start)/2;
            if(letters[mid]>target){                 //go left
                end=mid-1;
            }else{                                   //go right
                start=mid+1;
            }
        }
        return start<letters.length ? letters[start] : letters[0];
//      one more alternative to return statement but quite complex to understand for beginers
//      return letters[start % letters.length];
    }
}
