66. PLus One
https://leetcode.com/problems/plus-one/

class Solution {
    public int[] plusOne(int[] digits) {
        int n = digits.length;

        // Traverse from last digit
        for (int i = n - 1; i >= 0; i--) {
            if (digits[i] < 9) {
                digits[i]++; // Just add 1 and return
                return digits;
            }
            digits[i] = 0; // Set to 0 and continue loop
        }

        // If all digits were 9 (e.g., 999 → 1000), create a new array
        int[] result = new int[n + 1];
        result[0] = 1; // e.g., 1000
        return result;
    }
}
